NIO_LLM_PROVIDER=ollama
NIO_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NIO_DASHSCOPE_MODEL=qwen-plus
# Local semantic router: cockpit-slu-v11-round4:latest (Ollama, Q8_0, plain JSON output format)
NIO_VEHICLE_SLU_PROFILE=local-compact-v10
NIO_VEHICLE_SLU_WATCHDOG_MS=
NIO_CABIN_RESPONSE_PROVIDER=dashscope
NIO_CABIN_RESPONSE_MODEL=qwen-plus
NIO_CABIN_RESPONSE_FALLBACK_PROVIDER=ollama
NIO_CABIN_RESPONSE_FALLBACK_MODEL=qwen3:8b
NIO_CABIN_RESPONSE_WATCHDOG_MS=
NIO_KNOWLEDGE_ANSWER_PROVIDER=dashscope
NIO_KNOWLEDGE_ANSWER_MODEL=qwen3.8-flash
NIO_KNOWLEDGE_ANSWER_FALLBACK_PROVIDER=ollama
NIO_KNOWLEDGE_ANSWER_FALLBACK_MODEL=qwen3:8b
NIO_KNOWLEDGE_ANSWER_WATCHDOG_MS=
# Knowledge Answer falls back to the local model on provider errors or invalid structured output; it does not retry another cloud model.
# Export DASHSCOPE_API_KEY in the server process environment. Never commit its value.
